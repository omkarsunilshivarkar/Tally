# Port to run the Express backend on
PORT=5000

# ── WhatsApp Cloud API Configuration ──
# From Meta Developer Dashboard → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WEBHOOK_VERIFY_TOKEN=any_random_secret_string_you_choose

# ── Database ──
# Leave blank for local SQLite file (local.db)
# Or use Turso: libsql://your-db.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
